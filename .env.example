# ============================================
# ARQUIVO DE CONFIGURAÇÃO - Próximo Passo
# ============================================
#
# COMO USAR:
# 1. Copie este arquivo e renomeie a cópia para: .env
# 2. Preencha os valores abaixo
# 3. NUNCA suba o .env para o Git nem compartilhe (ele guarda segredos).
#    Este .env.example é o modelo e NÃO deve ter chaves reais.

# ============================================
# BANCO DE DADOS (padrões do XAMPP/WAMP)
# ============================================
DB_HOST=localhost
DB_NAME=proximo_passo
DB_USER=root
DB_PASS=

# ============================================
# SEGURANÇA (obrigatório)
# ============================================
# Segredo que assina o login (JWT). Mínimo de 32 caracteres.
# Gere um com:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_EXPIRATION=86400

# ============================================
# IA (GROQ)
# ============================================
# Chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=
# Segunda chave para revisar análises e tentar novamente após erro/limite da principal.
GROQ_API_KEY_FALLBACK=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT=30

# Cotações de ativos da B3. Sem chave, apenas PETR4, MGLU3, VALE3 e ITUB4.
# Obtenha em https://brapi.dev/dashboard
BRAPI_API_KEY=

# Limite de análises da IA por usuário (0 = sem limite)
AI_RATE_LIMIT_PER_MINUTE=6
AI_RATE_LIMIT_PER_HOUR=60

# ============================================
# AMBIENTE
# ============================================
# development = seu computador | production = servidor real
# Em production o debug é sempre desligado e erros não aparecem na tela.
APP_ENV=development
DEBUG_MODE=false

# E-mail de uma conta já cadastrada que terá acesso ao painel administrativo.
# Para vários administradores, separe os e-mails por vírgula.
ADMIN_EMAILS=
