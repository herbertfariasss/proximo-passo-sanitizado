# ============================================
# Configuração Apache - Próximo Passo
# ============================================

RewriteEngine On
RewriteBase /proximo-passo/

# ============================================
# CONFIGURAÇÕES DE SEGURANÇA
# ============================================

# Prevenir listagem de diretórios
Options -Indexes

# Proteger arquivos sensíveis (.env, .sql, .log, .ini, token.txt)
<FilesMatch "(^\.env.*|\.(env|sql|log|ini)|^token\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear scripts locais de diagnóstico na raiz, caso sejam adicionados.
<FilesMatch "^(debug|test)[-.\w]*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================
# EXCEÇÕES - Arquivos na raiz não redirecionam
# ============================================
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^.*\.php$ - [L]

# ============================================
# REDIRECIONAMENTOS DA API
# ============================================

# Todas as requisições para /api/* vão para api/routes.php
RewriteRule ^api/(.*)$ api/routes.php [L,QSA]

# ============================================
# FRONTEND
# ============================================

# Os assets são referenciados pela página como /css/*, /js/* e /assets/*,
# embora os arquivos estejam dentro de public/.
RewriteRule ^(css|js|assets)/(.*)$ public/$1/$2 [L]

# Redirecionar raiz para public/
RewriteRule ^$ public/index.php [L]
RewriteRule ^index\.php$ public/index.php [L]

# Se o arquivo ou diretório existir, servir diretamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Arquivos do public/
RewriteRule ^public/(.*)$ public/$1 [L]

# ============================================
# CONFIGURAÇÕES DE CACHE (PRODUÇÃO)
# ============================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>